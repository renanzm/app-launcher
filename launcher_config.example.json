{
  "app_name": "App Launcher",
  "app_id": "AppLauncher",
  "accent_color": "#7C5CFF",
  "language": "auto",
  "support_url": "https://github.com/renanzm/app-launcher/issues/new",

  "server": {
    "protocol": "ftp",
    "host": "127.0.0.1",
    "port": 2121,
    "user": "demo",
    "password": "demo"
  },

  "auth": {
    "type": "none"
  },

  "self_update": {
    "remote_dir": "/launcher",
    "file_name": "Launcher.exe"
  },

  "apps": [
    {
      "id": "notes",
      "name": "Notes Studio",
      "description": "Demo application served by tools/demo_server.py.",
      "remote_dir": "/apps/notes",
      "package": "notes.zip",
      "install_dir": "Notes Studio",
      "executable": "notes.bat",
      "env": { "NOTES_LAUNCHED_BY": "app-launcher" },
      "extra_actions": [
        { "label": "Open diagnostics tool", "executable": "diagnostics.bat" }
      ],
      "options": [
        { "key": "verbose", "label": "Verbose mode", "type": "bool", "env": "NOTES_VERBOSE",
          "description": "Shows extra messages on startup." },
        { "key": "workspace", "label": "Default workspace folder", "type": "text", "env": "NOTES_WORKSPACE",
          "default": "C:\\Notes" }
      ],
      "custom_builds": {
        "remote_subdir": "custom-builds",
        "code_label": "Ticket",
        "code_pattern": "^\\d{5}$",
        "code_hint": "Enter the ticket number provided by support (5 digits).",
        "package_names": ["build.zip", "dist.zip"],
        "carry_over_files": ["settings.ini"]
      }
    },
    {
      "id": "reports",
      "name": "Reports Viewer",
      "description": "Second demo application, with no extra options.",
      "remote_dir": "/apps/reports",
      "package": "reports.zip",
      "install_dir": "Reports Viewer",
      "executable": "reports.bat"
    }
  ],

  "downloads": [
    {
      "label": "Tools",
      "remote_dir": "/tools",
      "destination": "Downloads/Tools",
      "extra_files": [
        { "name": "sample-data.csv", "remote_dir": "/apps/reports", "badge": "Reports" }
      ]
    },
    {
      "label": "Installers",
      "remote_dir": "/installers",
      "destination": "Downloads/Installers"
    }
  ]
}
